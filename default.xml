<manifest>
  <remote name="pixelos"
          fetch="https://github.com/PixelOS-AOSP"
          revision="refs/heads/sixteen-qpr2" />

  <remote name="scandiumui"
          fetch="https://github.com/ScandiumUI"
          revision="refs/heads/sixteen-qpr2" />

  <remote name="aosp"
          fetch="https://android.googlesource.com"
          review="https://android-review.googlesource.com/" />

  <remote name="lineageos"
          fetch="https://github.com/LineageOS"
          revision="refs/heads/lineage-23.2" />

  <default revision="refs/heads/sixteen-qpr2"
           remote="pixelos"
           sync-j="4" />

  <project path="frameworks/base"
           name="ScandiumUI/android_frameworks_base"
           groups="pdk-cw-fs,pdk-fs,sysui-studio"
           remote="scandiumui" />

  <project path="packages/apps/Settings"
           name="ScandiumUI/android_packages_apps_Settings"
           groups="pdk-fs,pdk-cw-tvc,sysui-studio"
           remote="scandiumui" />

  <project path="packages/apps/SetupWizard"
           name="ScandiumUI/android_packages_apps_SetupWizard"
           remote="scandiumui" />

  <project path="vendor/scandiumui"
           name="ScandiumUI/android_vendor_scandiumui"
           remote="scandiumui" />

  <project path="vendor/lineage"
           name="ScandiumUI/android_vendor_lineage"
           remote="scandiumui" />

  <project path="build/make"
           name="ScandiumUI/android_build"
           groups="pdk,sysui-studio"
           remote="scandiumui">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

 <project path="frameworks/libs/systemui"
           name="ScandiumUI/android_frameworks_libs_systemui"
           groups="pdk-cw-fs,pdk-fs,sysui-studio"
           remote="scandiumui" /> 

 <project path="packages/apps/Launcher3"
           name="ScandiumUI/android_packages_apps_Launcher3"
           groups="pdk-fs,sysui-studio,pdk-cw-tvc"
           remote="scandiumui" /> 

 <project path="packages/apps/ThemePicker"
           name="ScandiumUI/android_packages_apps_ThemePicker"
           groups="pdk-fs,sysui-studio"
           remote="scandiumui" /> 

 <project path="packages/apps/WallpaperPicker2"
           name="ScandiumUI/android_packages_apps_WallpaperPicker2"
           groups="pdk-fs,sysui-studio"
           remote="scandiumui" /> 

 <project path="packages/apps/Updater"
           name="ScandiumUI/android_packages_apps_Updater"
           remote="scandiumui" /> 

</manifest>
